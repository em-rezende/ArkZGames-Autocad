<?xml version="1.0" encoding="utf-8"?>
<ApplicationPackage
   SchemaVersion="1.0"
   ProductType="Application"
   Name="ArkZ Games"
   AppVersion="1.0.0"
   FriendlyVersion="1.0.0"
   Description="Jogos Ark-Z para AutoCAD"
   Author="Ezequiel M Rezende"
   Icon="./Contents/Resources/Ark-Z.ico"
   AppNameSpace="appstore.exchange.autodesk.com"   
   HelpFile="./Contents/Resources/Index.htm"
   ProductCode="{DE541FD8-0E06-4677-A9E9-DDA271DDA2A6}"
