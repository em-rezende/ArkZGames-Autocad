          SupportPath="./Contents/;./Contents/Windows/"
          OS="Win32|Win64"
          Platform="AutoCAD*|AutoCAD"
          SeriesMin="R19.0"
          SeriesMax="R26.0"
      />
      
      <!-- Componentes principais que carregam automaticamente -->

      <ComponentEntry
          AppName="Ark-Z Games Ribbon"
          Version="1.0.0"
          ModuleName="./Contents/Windows/ArkZGames.cuix"
          AppDescription="Faixa de opções Ark-Z Games para AutoCAD"
          PerDocument="False"
          LoadOnAutoCADStartup="True"
      />
      
     
      <!-- LISTA DE COMANDOS DOS JOGOS -->
      <!-- Connect4 -->
      <Command Local="Connect4" Group="Ark-Z Games" Global="Connect4">
